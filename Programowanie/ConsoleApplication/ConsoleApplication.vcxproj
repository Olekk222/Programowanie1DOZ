#include <iostream>
using namespace std;

// 1. Wyświetl "Hello world" tyle razy ile chce użytkownik
void task1() {
    int howManyTimes;
    cout << "Podaj ile razy wyswietlic:\n";
    cin >> howManyTimes;

    for (int i = 0; i < howManyTimes; i++) {
        cout << "Hello world\n";
    }
}

// 2. Wyświetl liczby parzyste do podanej przez użytkownika liczby
void task2() {
    int upperRange;
    cout << "Podaj gorna granice:\n";
    cin >> upperRange;

    for (int i = 0; i <= upperRange; i++) {
        if (i % 2 == 0) {
            cout << i << "\n";
        }
    }
}

// 3. Suma liczb od 1 do 100
void task3() {
    int sum = 0;
    for (int i = 1; i <= 100; i++) {
        sum += i;
    }
    cout << "Suma: " << sum << "\n";
}

// 4. Liczby podzielne przez 3 z zakresu 1–100
void task4() {
    for (int i = 1; i <= 100; i++) {
        if (i % 3 == 0) {
            cout << i << "\n";
        }
    }
}

// 5. Wypisz liczby od 10 do 1 w odwrotnej kolejności
void task5() {
    for (int i = 10; i >= 1; i--) {
        cout << i << "\n";
    }
}

// 6. Iloczyn liczb od 1 do podanej przez użytkown3ika
void task6() {
    int n;
    long long iloczyn = 1;

    cout << "Podaj liczbe:\n";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        iloczyn *= i;
    }

    cout << "Iloczyn: " << iloczyn << "\n";
}

// 7. Wypisz rosnącą liczbę cyfr np.
// 1
// 12
// 123
// 1234
void task7() {
    int n;
    cout << "Podaj liczbe:\n";
    cin >> n;

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= i; j++) {
            cout << j;
        }
        cout << "\n";
    }
}

